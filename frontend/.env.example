# QUANTIQEN monitoring — SERVER-ONLY variables.
# Never prefix these with NEXT_PUBLIC_: they must never reach a browser bundle.
# Leave QUANTIQEN_API_KEY empty to disable telemetry (the wrapper then no-ops).

# API key format: qtn_live_* (Production) | qtn_test_* or qtn_dev_* (Preview/local).
# Create keys in QUANTIQEN organization settings and store them in Vercel
# Project → Environment Variables, separately for Production and Preview.
QUANTIQEN_API_KEY=

# Optional self-hosted gateway override. Defaults to the SDK's base URL.
QUANTIQEN_BASE_URL=

# UUID of the registered anantnetra.com asset. Leave empty when unknown —
# the field is omitted rather than guessed.
QUANTIQEN_ASSET_ID=

# Attribution source attached to every event.
QUANTIQEN_SOURCE=anantnetra-website
